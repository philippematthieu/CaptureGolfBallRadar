\section{Contrat de temps : définitions et hypothèses}
% =========================================================
 
\begin{definition}[Tick global]
On définit le tick global discret par :
\begin{equation}
t_k = t_0 + kT_s
\label{eq:tick}
\end{equation}
où \(T_s\) est la période de référence partagée par les composants du système.
\end{definition}
 
\begin{definition}[Absence explicite]
L’absence de donnée à l’instant logique \(t_k\) est un état explicite du système. Dans sa forme minimale, elle est modélisée par un maintien logiciel :
\begin{equation}
y[k] =
\begin{cases}
y(t_k) & \text{si disponible} \\
y[k-1] & \text{sinon}
\end{cases}
\label{eq:absence}
\end{equation}
\end{definition}
 
\begin{definition}[Classification des retards]
Nous distinguons :
\begin{itemize}
\item les retards \emph{physiques} (\(\tau + \mathrm{ZOH}\)) liés à la chaîne capteur/actionneur ;
\item les retards \emph{logiciels} (\(\mathrm{ZOH}_{SW}\)) issus des politiques d’absence ;
\item les retards \emph{artificiels} (\(z^{-1}\)) introduits uniquement par l’interface ou l’outillage.
\end{itemize}
Seuls les deux premiers sont autorisés.
\end{definition}
 
\begin{remark}
L’usage FIFO de données horodatées est incompatible avec ce contrat : une valeur reçue en retard ne remplace pas automatiquement la valeur correspondant au tick courant.
\end{remark}
 
