\contentsline {myremarks}{\numberline {1}Enfin, l'équation de la force de traînée selon les 3 axes devient \ref {eq:vectordragforce}}{6}{}%
\contentsline {myremarks}{\numberline {2}Connaissant \ref {eq:magnusforce1}, \ref {eq:magnusforce7} et \ref {eq:mycl1}, j'ai choisi le modèle de force de Magnus suivant}{7}{}%
\contentsline {myremarks}{\numberline {3}La force de gravité}{7}{}%
